
<%# app/views/neighborhoods/show.html.erb %>

<div class="nb-page">

  <!-- BREADCRUMB -->
  <div class="nb-breadcrumb">
    <%= link_to "Tokyo", root_path %>
    <span class="nb-bc-sep"><i class="fa-solid fa-chevron-right"></i></span>
    <%= link_to "Neighbourhoods", neighborhoods_path %>
    <span class="nb-bc-sep"><i class="fa-solid fa-chevron-right"></i></span>
    <span><%= @neighborhood.name %></span>
  </div>

  <!-- HERO -->
  <div class="nb-hero">
    <div class="nb-hero-content">
      <div class="nb-hero-eyebrow">
        <i class="fa-solid fa-location-dot"></i>
        <%= @neighborhood.ward %> Ward · Tokyo
      </div>

      <h1 class="nb-hero-title"><%= @neighborhood.name %></h1>

      <p class="nb-hero-lead">
        <%= @neighborhood.description %>
      </p>

      <div class="nb-hero-actions">
        <%= link_to "View listings in #{@neighborhood.name}",
            properties_path(neighborhood: @neighborhood.id),
            class: "nb-btn-primary" %>

        <%= link_to "Back to map",
            root_path(anchor: "map"),
            class: "nb-btn-secondary" %>
      </div>
    </div>

    <!-- HERO VISUAL -->
    <div class="nb-hero-visual" style="background: linear-gradient(135deg, #2C1810 0%, #8B4513 50%, #C9973A 100%);">
      <div class="nb-hero-overlay">
        <div class="nb-hero-stat">
          <div class="nb-hero-stat-num">
            <%= @neighborhood.properties.count rescue "—" %>
          </div>

          <div class="nb-hero-stat-label">
            Available homes
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- BODY -->
  <div class="nb-body">

    <!-- MAIN -->
    <div class="nb-main">

      <!-- ABOUT -->
      <section class="nb-section">
        <div class="nb-section-label">
          About the area
        </div>

        <div class="nb-prose">
          <%= @neighborhood.description %>
        </div>
      </section>

      <div class="nb-divider"></div>

      <!-- FEATURES -->
      <section class="nb-section">
        <div class="nb-section-label">
          What makes it special
        </div>

        <div class="nb-features-grid">

          <%
            features = @neighborhood.features.is_a?(Array) ?
              @neighborhood.features :
              @neighborhood.features.to_s.split(",").map(&:strip)
          %>

          <% features.each do |feature| %>
            <div class="nb-feature-card">
              <div class="nb-feature-icon">✦</div>

              <div class="nb-feature-text">
                <%= feature %>
              </div>
            </div>
          <% end %>

          <% if features.empty? %>
            <p class="nb-empty">
              No features listed yet.
            </p>
          <% end %>

        </div>
      </section>

      <div class="nb-divider"></div>

      <!-- MAP -->
      <section class="nb-section">
        <div class="nb-section-label">
          Map
        </div>

        <div class="nb-map-placeholder">
          <div class="nb-map-inner">
            <i class="fa-regular fa-map"></i>
            <p>Map coming soon</p>
            <small>Connect Google Maps or Mapbox</small>
          </div>
        </div>
      </section>

    </div>

    <!-- SIDEBAR -->
    <div class="nb-sidebar">

      <!-- QUICK FACTS -->
      <div class="nb-card">

        <div class="nb-card-head">
          Quick facts
        </div>

        <div class="nb-fact-list">

          <div class="nb-fact">
            <span class="nb-fact-icon">🏙️</span>

            <div>
              <div class="nb-fact-label">Ward</div>

              <div class="nb-fact-val">
                <%= @neighborhood.ward %>
              </div>
            </div>
          </div>

          <div class="nb-fact">
            <span class="nb-fact-icon">🏠</span>

            <div>
              <div class="nb-fact-label">Listings</div>

              <div class="nb-fact-val">
                <%= @neighborhood.properties.count rescue "—" %> homes
              </div>
            </div>
          </div>

          <div class="nb-fact">
            <span class="nb-fact-icon">🚆</span>

            <div>
              <div class="nb-fact-label">Transit</div>

              <div class="nb-fact-val">
                Multiple lines
              </div>
            </div>
          </div>

          <div class="nb-fact">
            <span class="nb-fact-icon">🌐</span>

            <div>
              <div class="nb-fact-label">English support</div>

              <div class="nb-fact-val">
                Available
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- OTHER NEIGHBOURHOODS -->
      <div class="nb-card">

        <div class="nb-card-head">
          Other neighbourhoods
        </div>

        <div class="nb-nb-list">

          <% Neighborhood.where.not(id: @neighborhood.id).limit(5).each do |nb| %>

            <%= link_to neighborhood_path(nb), class: "nb-nb-item" do %>

              <span class="nb-nb-name">
                <%= nb.name %>
              </span>

              <i class="fa-solid fa-arrow-right nb-nb-arrow"></i>

            <% end %>

          <% end %>

        </div>
      </div>

      <!-- CTA -->
      <div class="nb-card nb-card-cta">

        <div class="nb-cta-title">
          Ready to find your home?
        </div>

        <div class="nb-cta-body">
          Browse all available furnished apartments in
          <%= @neighborhood.name %>.
        </div>

        <%= link_to "See listings",
            properties_path(neighborhood: @neighborhood.id),
            class: "nb-btn-primary nb-btn-full" %>

      </div>

    </div>

  </div>
</div>
```


<style>
  /* ── LODGI DESIGN TOKENS ── */
  :root {
    --cream:        #FAF7F2;
    --cream-dark:   #F0EBE1;
    --ink:          #1A1714;
    --ink-soft:     #4A4540;
    --ink-muted:    #8A8480;
    --terra:        #C8553D;
    --terra-hover:  #b34832;
    --green:        #3D6B4F;
    --border:       rgba(26,23,20,0.10);
    --border-md:    rgba(26,23,20,0.18);
    --shadow-sm:    0 2px 8px rgba(0,0,0,0.06);
    --shadow-md:    0 8px 24px rgba(0,0,0,0.08);
    --radius:       12px;
    --radius-lg:    16px;
  }

  .nb-page {
    max-width: 1060px;
    margin: 0 auto;
    padding: 28px 32px 80px;
    font-family: 'DM Sans', system-ui, sans-serif;
    color: var(--ink);
  }

  /* BREADCRUMB */
  .nb-breadcrumb {
    display: flex; align-items: center; gap: 6px;
    font-size: 13px; color: var(--ink-muted);
    margin-bottom: 24px;
  }
  .nb-breadcrumb a { color: var(--ink-muted); text-decoration: none; }
  .nb-breadcrumb a:hover { color: var(--ink); text-decoration: underline; }
  .nb-bc-sep { font-size: 10px; }

  /* HERO */
  .nb-hero {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 32px;
    align-items: center;
    margin-bottom: 52px;
  }
  .nb-hero-eyebrow {
    font-size: 11.5px; font-weight: 500;
    letter-spacing: .1em; text-transform: uppercase;
    color: var(--terra); margin-bottom: 14px;
    display: flex; align-items: center; gap: 6px;
  }
  .nb-hero-title {
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: 46px; font-weight: 400; line-height: 1.1;
    margin-bottom: 16px;
  }
  .nb-hero-lead {
    font-size: 15.5px; line-height: 1.75;
    color: var(--ink-soft);
    margin-bottom: 28px;
    max-width: 520px;
  }
  .nb-hero-actions { display: flex; gap: 10px; flex-wrap: wrap; }

  .nb-hero-visual {
    height: 320px; border-radius: var(--radius-lg);
    overflow: hidden; position: relative;
  }
  .nb-hero-overlay {
    position: absolute; inset: 0;
    background: rgba(0,0,0,0.25);
    display: flex; align-items: flex-end;
    padding: 22px;
  }
  .nb-hero-stat {
    background: rgba(255,255,255,0.15);
    backdrop-filter: blur(8px);
    border: 0.5px solid rgba(255,255,255,0.25);
    border-radius: var(--radius);
    padding: 14px 20px;
    color: white;
  }
  .nb-hero-stat-num {
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: 32px; line-height: 1;
    margin-bottom: 4px;
  }
  .nb-hero-stat-label { font-size: 12px; opacity: .85; }

  /* BUTTONS */
  .nb-btn-primary {
    display: inline-flex; align-items: center;
    background: var(--terra); color: white;
    padding: 11px 22px; border-radius: 50px;
    font-size: 14px; font-weight: 500;
    text-decoration: none;
    transition: background .15s;
  }
  .nb-btn-primary:hover { background: var(--terra-hover); }
  .nb-btn-secondary {
    display: inline-flex; align-items: center;
    background: white; color: var(--ink-soft);
    border: 0.5px solid var(--border-md);
    padding: 11px 22px; border-radius: 50px;
    font-size: 14px; font-weight: 400;
    text-decoration: none;
    transition: background .15s, color .15s;
  }
  .nb-btn-secondary:hover { background: var(--cream-dark); color: var(--ink); }
  .nb-btn-full { width: 100%; justify-content: center; }

  /* BODY LAYOUT */
  .nb-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 292px;
    gap: 32px;
    align-items: start;
  }

  /* SECTIONS */
  .nb-section { margin-bottom: 4px; }
  .nb-section-label {
    font-size: 11px; font-weight: 500;
    letter-spacing: .1em; text-transform: uppercase;
    color: var(--ink-muted); margin-bottom: 14px;
  }
  .nb-prose {
    font-size: 15px; line-height: 1.78;
    color: var(--ink);
  }
  .nb-divider {
    height: 0.5px; background: var(--border);
    margin: 32px 0;
  }

  /* FEATURES GRID */
  .nb-features-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .nb-feature-card {
    display: flex; align-items: flex-start; gap: 12px;
    background: white;
    border: 0.5px solid var(--border);
    border-radius: var(--radius);
    padding: 14px 16px;
    transition: box-shadow .15s;
  }
  .nb-feature-card:hover { box-shadow: var(--shadow-sm); }
  .nb-feature-icon {
    color: var(--terra); font-size: 14px;
    margin-top: 1px; flex-shrink: 0;
  }
  .nb-feature-text { font-size: 14px; color: var(--ink); line-height: 1.5; }
  .nb-empty { font-size: 13.5px; color: var(--ink-muted); }

  /* MAP PLACEHOLDER */
  .nb-map-placeholder {
    height: 300px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 0.5px solid var(--border);
    background: var(--cream-dark);
  }
  .nb-map-placeholder iframe {
    width: 100%; height: 100%; border: none; display: block;
  }
  .nb-map-inner {
    width: 100%; height: 100%;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 8px;
    color: var(--ink-muted);
  }
  .nb-map-inner i { font-size: 40px; }
  .nb-map-inner p { font-size: 14px; color: var(--ink-soft); }
  .nb-map-inner small { font-size: 12px; }

  /* SIDEBAR CARDS */
  .nb-sidebar { display: flex; flex-direction: column; gap: 16px; position: sticky; top: 80px; }
  .nb-card {
    background: white;
    border: 0.5px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .nb-card-head {
    padding: 14px 18px;
    font-size: 13px; font-weight: 500;
    border-bottom: 0.5px solid var(--border);
    color: var(--ink);
  }

  /* QUICK FACTS */
  .nb-fact-list { padding: 4px 0; }
  .nb-fact {
    display: flex; align-items: center; gap: 12px;
    padding: 11px 18px;
    border-bottom: 0.5px solid var(--border);
  }
  .nb-fact:last-child { border-bottom: none; }
  .nb-fact-icon { font-size: 18px; flex-shrink: 0; width: 26px; text-align: center; }
  .nb-fact-label { font-size: 11.5px; color: var(--ink-muted); margin-bottom: 1px; }
  .nb-fact-val { font-size: 13.5px; color: var(--ink); font-weight: 500; }

  /* OTHER NEIGHBOURHOODS */
  .nb-nb-list { padding: 4px 0; }
  .nb-nb-item {
    display: flex; align-items: center; justify-content: space-between;
    padding: 11px 18px;
    text-decoration: none;
    border-bottom: 0.5px solid var(--border);
    transition: background .12s;
  }
  .nb-nb-item:last-child { border-bottom: none; }
  .nb-nb-item:hover { background: var(--cream-dark); }
  .nb-nb-name { font-size: 13.5px; color: var(--ink); }
  .nb-nb-arrow { font-size: 12px; color: var(--ink-muted); }

  /* CTA CARD */
  .nb-card-cta { padding: 20px 20px; border: 0.5px solid var(--border); }
  .nb-cta-title {
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: 19px; margin-bottom: 6px;
  }
  .nb-cta-body {
    font-size: 13.5px; color: var(--ink-muted);
    margin-bottom: 16px; line-height: 1.55;
  }

  /* RESPONSIVE */
  @media (max-width: 768px) {
    .nb-page { padding: 20px 16px 60px; }
    .nb-hero { grid-template-columns: 1fr; }
    .nb-hero-visual { height: 220px; }
    .nb-hero-title { font-size: 32px; }
    .nb-body { grid-template-columns: 1fr; }
    .nb-sidebar { position: static; }
    .nb-features-grid { grid-template-columns: 1fr; }
  }
</style>
