
<div class="nb-page">

  <%# ── BREADCRUMB ── %>
  <nav class="nb-breadcrumb">
    <%= link_to "Tokyo", root_path %>
    <span class="nb-bc-sep">›</span>
    <%= link_to "Neighborhoods", root_path(anchor: "neighborhoods") %>
    <span class="nb-bc-sep">›</span>

    <span><%= @neighborhood.name %></span>
  </nav>

  <%# ── HERO ── %>
  <div class="nb-hero">
    <div class="nb-hero-content">
      <p class="nb-eyebrow">
        <i class="fa-solid fa-location-dot"></i>
        <%= @neighborhood.ward %> Ward · Tokyo
      </p>
      <h1 class="nb-hero-title"><%= @neighborhood.name %></h1>
      <p class="nb-hero-lead"><%= @neighborhood.description %></p>
      <div class="nb-hero-actions">
        <%= link_to "View listings in #{@neighborhood.name}",
              "#properties",
              class: "nb-btn nb-btn--primary" %>
        <%= link_to "Back to home",
              root_path(anchor: "map"),
              class: "nb-btn nb-btn--secondary" %>
      </div>
    </div>

    <%# Swap this div for a real map embed when API is ready %>
   <div class="nb-hero-map">
    <iframe
      width="100%"
      height="100%"
      style="border:0"
      loading="lazy"
      allowfullscreen
      src="https://maps.google.com/maps?q=<%= CGI.escape(@neighborhood.name + ', Tokyo') %>&z=15&output=embed">
    </iframe>
</div>
  </div>

  <%# ── BODY (main + sidebar) ── %>
  <div class="nb-body">

    <%# ── MAIN ── %>
    <div class="nb-main">

      <%# About %>
      <section class="nb-section">
        <h2 class="nb-section-label">About the area</h2>
        <p class="nb-prose"><%= @neighborhood.description %></p>
      </section>

      <hr class="nb-divider">

      <%# Features %>
      <section class="nb-section">
        <h2 class="nb-section-label">What makes it special</h2>
        <div class="nb-features-grid">
          <%
            features = @neighborhood.features.is_a?(Array) ?
              @neighborhood.features :
              @neighborhood.features.to_s.split(",").map(&:strip)
          %>
          <% if features.any? %>
            <% features.each do |f| %>
              <div class="nb-feature-card">
                <span class="nb-feature-icon">✦</span>
                <span class="nb-feature-text"><%= f %></span>
              </div>
            <% end %>
          <% else %>
            <p class="nb-empty">No features listed yet.</p>
          <% end %>
        </div>
      </section>

      <hr class="nb-divider">

      <%# Available homes %>
      <section class="nb-section">
        <div class="nb-properties-header">
          <h2 class="nb-section-label" id="properties">All properties in <%= @neighborhood.name %></h2>
          <span class="nb-properties-count">
            <%= @neighborhood.properties.count %> listing<%= @neighborhood.properties.count == 1 ? "" : "s" %>
          </span>
        </div>

        <% if @neighborhood.properties.any? %>
          <div class="nb-properties-grid">
            <% @neighborhood.properties.each do |property| %>
              <div class="nb-prop-card">

                <%# Image %>
                <% img = property.images.first if property.respond_to?(:images) %>
                <div class="nb-prop-img <% img.present? ? '': 'nb-prop-img--empty' %>" style="<%= property.respond_to?(:images) ?
                "background-image:url(#{img})" : '' %>">
                     <%= render "properties/favorite_button", property: property %>
                  <% unless img.present? %>
                    <i class="fa-regular fa-image"></i>
                  <% end %>
                </div>


                <%# Info %>
                <div class="nb-prop-body">
                  <div class="nb-prop-name"><%= property.name %></div>

                  <div class="nb-prop-tags">
                    <% if property.try(:layout).present? %>
                      <span><%= property.layout %></span>
                    <% end %>
                    <% if property.try(:size).present? %>
                      <span><%= property.size.to_i %>㎡</span>
                    <% end %>
                    <% if property.try(:bedrooms).present? %>
                      <span><%= property.bedrooms %> bed</span>
                    <% end %>
                  </div>


                  <div class="nb-prop-footer">
                    <div class="nb-prop-price">
                      <% if property.try(:price).present? %>
                        ¥<%= number_with_delimiter(property.price.to_i) %>
                        <span>/ mo</span>
                      <% else %>
                        On request
                      <% end %>
                    </div>

                    <% if property.try(:availability).present? %>
                      <span class="nb-prop-badge nb-prop-badge--available">Available <%= property.availability %></span>
                    <% else %>
                      <span class="nb-prop-badge nb-prop-badge--unavailable">Unavailable</span>
                    <% end %>
                  </div>

                </div>
              <%= link_to '', property_path(property), class:"nb-prop-card-link" %>
                </div>

            <% end %>
          </div>
        <% else %>
          <p class="nb-empty">No homes listed in this neighbourhood yet.</p>
        <% end %>
      </section>

    </div><%# /nb-main %>

    <%# ── SIDEBAR ── %>
    <aside class="nb-sidebar">

      <%# Quick facts %>
      <div class="nb-card">
        <div class="nb-card-head">Quick facts</div>
        <ul class="nb-fact-list">
          <li class="nb-fact">
            <i class="fa-solid fa-city nb-fact-icon"></i>
            <div>
              <div class="nb-fact-label">Ward</div>
              <div class="nb-fact-val"><%= @neighborhood.ward %></div>
            </div>
          </li>
          <li class="nb-fact">
            <i class="fa-solid fa-house nb-fact-icon"></i>
            <div>
              <div class="nb-fact-label">Listings</div>
              <div class="nb-fact-val"><%= @neighborhood.properties.count rescue "—" %> homes</div>
            </div>
          </li>
          <li class="nb-fact">
            <i class="fa-solid fa-train-subway nb-fact-icon"></i>
            <div>
              <div class="nb-fact-label">Transit</div>
              <div class="nb-fact-val">Multiple lines</div>
            </div>
          </li>
          <li class="nb-fact">
            <i class="fa-solid fa-language nb-fact-icon"></i>
            <div>
              <div class="nb-fact-label">English support</div>
              <div class="nb-fact-val">Available</div>
            </div>
          </li>
        </ul>
      </div>

      <%# Other neighborhoods %>
      <div class="nb-card">
        <div class="nb-card-head">Other neighborhoods</div>
        <div class="nb-other-list">
          <% Neighborhood.where.not(id: @neighborhood.id).limit(5).each do |nb| %>
            <%= link_to neighborhood_path(nb), class: "nb-other-item" do %>
              <span><%= nb.name %></span>
              <i class="fa-solid fa-arrow-right"></i>
            <% end %>
          <% end %>
        </div>
      </div>

      <%# CTA %>
      <div class="nb-card nb-card--cta">
        <p class="nb-cta-title">Ready to find your home?</p>
        <p class="nb-cta-body">Browse furnished apartments in <%= @neighborhood.name %>.</p>
        <%= link_to "See listings",
              properties_path(neighborhood: @neighborhood.id),
              class: "nb-btn nb-btn--primary nb-btn--full" %>
      </div>

    </aside>

  </div><%# /nb-body %>
</div><%# /nb-page %>
