<div class="page">
  <!-- BREADCRUMB -->
  <div class="breadcrumb mt-10">
    <%= link_to "Tokyo", root_path %>

    <i class="fa-solid fa-chevron-right"></i>

    <%= link_to @property.neighborhood.name,
        neighborhood_path(@property.neighborhood) %>

    <i class="fa-solid fa-chevron-right"></i>

    <span><%= @property.name %></span>
  </div>

  <!-- TITLE + FIT SUMMARY -->
  <div class="apt-header">
    <div class="apt-header__top">
      <div class="apt-title-row">
        <h1 class="apt-title"><%= @property.name %></h1>
        <%= render "properties/favorite_button", property: @property %>
      </div>

      <%# Fit summary — score + commute/station/quiet rows for the current inquiry. Rendered
          client-side by fit_summary_controller (reuses the map's scoring engine). %>
      <div class="fit-summary"
           data-controller="fit-summary"
           data-fit-summary-normalized-inputs-value="<%= json_escape(@fit_normalized.to_json) %>"
           data-fit-summary-weights-value="<%= json_escape({ commute: @commute_weight, quiet: @quiet_weight, station: @station_weight }.to_json) %>"
           data-fit-summary-has-anchor-value="<%= @selected_anchor.present? %>"
           data-fit-summary-anchor-name-value="<%= @selected_anchor&.dig('name') %>"
           data-fit-summary-score-inputs-value="<%= json_escape(@property.score_inputs.to_json) %>"
           data-fit-summary-travel-time-value="<%= @fit_travel_time || -1 %>"></div>
    </div>

    <div class="apt-meta">
      <%= link_to neighborhood_path(@property.neighborhood.id), class: "apt-meta-link", style: "text-decoration: none; color: inherit;" do %>
        <span>
          <i class="fa-solid fa-location-dot"></i>
          <%= @property.neighborhood.name %>, Tokyo
        </span>
      <% end %>
    </div>
  </div>

  <!-- TWO-COLUMN LAYOUT -->
  <div class="content-grid">
    <!-- LEFT -->
    <div class="left">
      <!-- GALLERY -->
      <div class="gallery" data-controller="gallery">
        <% @property.images.first(3).each do |image| %>
          <div class="gp">
            <a href="<%= image %>" class="glightbox">
              <img src="<%= image %>" alt="Property image" style="width:100%;height:100%;object-fit:cover">
            </a>
          </div>
        <% end %>
        <div class="gp" style="position:relative;">
          <a href="<%= @property.images[3] %>" class="glightbox">
            <img src="<%= @property.images[3] %>" alt="Property image" style="width:100%;height:100%;object-fit:cover">
          </a>
          <button class="photo-all-btn" data-action="click->gallery#open">
            <i class="fa-regular fa-grid-2"></i> Show all <%= @property.images.length %> photos
          </button>
        </div>
        <%# Hidden links for remaining images so GLightbox knows about them %>
        <% @property.images.drop(4).each do |image| %>
          <a href="<%= image %>" class="glightbox" style="display:none;"></a>
        <% end %>
      </div>
      <!-- DESCRIPTION -->
      <% if @property.description.present? %>
        <div class="section-label">About this property</div>
        <div data-controller="property-description">
          <p class="description" data-property-description-target="short">
            <%= @property.description.truncate(200, omission: '...', separator: ' ') %>
          </p>
          <p class="description" data-property-description-target="long" style="display: none;">
            <%= @property.description %>
          </p>
          <% if @property.description.length > 200 %>
            <button class="desc-toggle"
                    data-property-description-target="button"
                    data-action="click->property-description#toggle">
              Show more ›
            </button>
          <% end %>
        </div>
        <div class="divider"></div>
      <% end %>
      <!-- AMENITIES -->
      <div class="section-label">Amenities</div>
      <div class="amenities-grid">

        <% @property.all_amenities.each do |amenity_name| %>

          <% amenity =
              Amenity.find_by(
                "LOWER(TRIM(name)) = ?",
                amenity_name.strip.downcase
              )
          %>

          <% Rails.logger.debug(
              "AMENITY LOOKUP => '#{amenity_name}' -> '#{amenity&.name || "NOT FOUND"}'"
            )
          %>
          <div class="am-item">

            <div class="am-icon">

              <% if amenity&.icon.present? %>

                <iconify-icon
                  icon="<%= amenity.icon %>">
                </iconify-icon>

              <% else %>

                <i class="fa-solid fa-circle-check"></i>

              <% end %>

            </div>

            <div>

              <div class="am-name">
                <%= amenity_name %>
              </div>

            </div>

          </div>

        <% end %>

      </div>
      <div class="divider"></div>
      <div class="section-label">
  3D Tour
</div>

<div class="matterport-section">

  <% if @property.matterport_url.present? %>

    <a
      href="<%= @property.matterport_url %>"
      target="_blank"
      rel="noopener"
      class="matterport-button"
    >

      <iconify-icon
        icon="mdi:cube-scan"
      ></iconify-icon>

      <span>
        Explore 3D Property Layout
      </span>

    </a>

  <% else %>

    <div class="matterport-unavailable">
      3D tour unavailable
    </div>

  <% end %>

</div>
    </div>
    <!-- /left -->

    <!-- RIGHT SIDEBAR -->
    <div class="right">

      <!-- MAP CARD -->
      <div class="map-card">
        <div class="map-preview">
          <div
            id="property-map"
            data-controller="property-map"
            data-lat="<%= @property.latitude %>"
            data-lng="<%= @property.longitude %>">
          </div>

          <button
            class="map-expand-btn"
            onclick="event.stopPropagation(); openMap()">
            <i class="fa-solid fa-expand"></i> Expand
          </button>

        </div>
          <button class="map-expand-btn" onclick="event.stopPropagation(); openMap()">
            <i class="fa-solid fa-expand"></i> Expand
          </button>

        <div class="map-card-body">
          <% @property.stations.each do |station| %>
            <div class="map-station">
              <i class="fa-solid fa-train-subway"></i>
              <%= station %>
            </div>
          <% end %>
          <%= link_to neighborhood_path(@property.neighborhood.id), class: "nb-link" do %>
            <i class="fa-regular fa-map"></i>
            Explore <%= @property.neighborhood.name %>
            <i class="fa-solid fa-arrow-right"></i>
          <% end %>
        </div>
      </div>
      <!-- PRICE CARD -->
      <div class="price-card">
        <div class="price-main">
          ¥<%= number_with_delimiter(@property.price.to_i) %>
          <span>/ month</span>
            <div
              class="vendor-avatar"
              title="Managed by <%= @property.vendor %>"
            >
              <img
                src="<%= @property.vendor_image %>"
                alt="<%= @property.vendor %>"
              >
            </div>
        </div>
        <div class="price-note">
          <%= "Available #{@property.availability}" %><br>
        </div>
        <div class="stay-dates" data-controller="date-picker">
          <div class="date-field">
            <label class="date-label" for="start_date">Check-in</label>
            <input class="date-input" type="date" id="start_date"
                  value="<%= @checkin %>"
                  data-date-picker-target="startDate"
                  data-action="change->date-picker#onChange">
          </div>
          <div class="date-field">
            <label class="date-label" for="end_date">Check-out</label>
            <input class="date-input" type="date" id="end_date"
                  value="<%= @checkout %>"
                  data-date-picker-target="endDate"
                  data-action="change->date-picker#onChange">
          </div>
        </div>
        <%
          agent_email = "#properties@#{@property.vendor}.com"
          subject = ERB::Util.url_encode("Inquiry regarding Prime Urban Meguro Riverfront 301 / プライムアーバン目黒リバーフロント301に関するお問い合わせ")
          body = ERB::Util.url_encode("Hello,\r\n\r\nI am interested in staying at Prime Urban Meguro Riverfront 301 from June 15th to August 2nd and would like to request more information.\r\n\r\nThank you,\r\n\r\n---\r\n\r\nはじめまして。\r\n\r\nプライムアーバン目黒リバーフロント301に、6月15日から8月2日までの滞在を検討しており、詳細についてお伺いしたく、ご連絡いたしました。\r\n\r\nご確認のほど、よろしくお願いいたします。")        %>
        <% checkin_date = @checkin.present? ? Date.parse(@checkin) : nil %>
        <% available = available_for_checkin?(@property.availability, checkin_date) %>
        <% if checkin_date && !available %>
          <div class="book-btn book-btn--muted" style="text-decoration: none;">
            Change dates to book
          </div>
        <% elsif user_signed_in? %>
          <a href="mailto:<%= agent_email %>?subject=<%= subject %>&body=<%= body %>"
            class="book-btn"
            style="text-decoration: none;">
            Request to book
          </a>
        <% else %>
          <%= link_to "Sign in to book", new_user_session_path(redirect_to: request.fullpath),
                class: "book-btn",
                style: "text-decoration: none;" %>
        <% end %>
      </div>
    </div>
    <!-- /right -->
  </div>
  <!-- /content-grid -->
</div>
