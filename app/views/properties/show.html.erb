<div class="page">

  <!-- BREADCRUMB -->
  <div class="breadcrumb mt-10">
    <a href="index.html">Tokyo</a>
    <i class="fa-solid fa-chevron-right"></i>
    <a href="neighborhood.html?area=shinjuku">Shinjuku</a>
    <i class="fa-solid fa-chevron-right"></i>
    <span>Shinjuku Studio</span>
  </div>

  <!-- TITLE -->
  <h1 class="apt-title"><%= @property.name %></h1>
  <div class="apt-meta">
    <span><i class="fa-solid fa-location-dot"></i> <%= @property.neighborhood.name %>, Tokyo</span>
  </div>

  <!-- TWO-COLUMN LAYOUT -->
  <div class="content-grid">

    <!-- LEFT -->
    <div class="left">

      <!-- GALLERY -->
      <div class="gallery" data-controller="gallery">
        <% @property.images.first(3).each do |image| %>
          <div class="gp">
            <a href="<%= image %>" class="glightbox">
              <img src="<%= image %>" alt="Property image" style="width:100%;height:100%;object-fit:cover">
            </a>
          </div>
        <% end %>
        <div class="gp" style="position:relative;">
          <a href="<%= @property.images[3] %>" class="glightbox">
            <img src="<%= @property.images[3] %>" alt="Property image" style="width:100%;height:100%;object-fit:cover">
          </a>
          <button class="photo-all-btn" data-action="click->gallery#open">
            <i class="fa-regular fa-grid-2"></i> Show all <%= @property.images.length %> photos
          </button>
        </div>

        <%# Hidden links for remaining images so GLightbox knows about them %>
        <% @property.images.drop(4).each do |image| %>
          <a href="<%= image %>" class="glightbox" style="display:none;"></a>
        <% end %>
      </div>

      <!-- DESCRIPTION -->
      <div class="section-label">About this property</div>
      <div data-controller="property-description">
        <p class="description" data-property-description-target="short">
          <%= @property.description.truncate(200, omission: '...', separator: ' ') %>
        </p>
        <p class="description" data-property-description-target="long" style="display: none;">
          <%= @property.description %>
        </p>
        <% if @property.description.length > 200 %>
          <button class="desc-toggle"
                  data-property-description-target="button"
                  data-action="click->property-description#toggle">
            Show more ›
          </button>
        <% end %>
      </div>


      <div class="divider"></div>

      <!-- AMENITIES -->
      <div class="section-label">Amenities</div>
      <div class="amenities-grid">

        <div class="am-item">
  <div class="am-icon"><i class="fa-solid fa-soap"></i></div>
  <div>
    <div class="am-name">Washing machine</div>
    <div class="am-sub">In-unit, front-load</div>
  </div>
</div>

<div class="am-item">
  <div class="am-icon"><i class="fa-solid fa-snowflake"></i></div>
  <div>
    <div class="am-name">Air conditioning</div>
    <div class="am-sub">Hot &amp; cold, all rooms</div>
  </div>
</div>

<div class="am-item">
  <div class="am-icon"><i class="fa-solid fa-wifi"></i></div>
  <div>
    <div class="am-name">High-speed WiFi</div>
    <div class="am-sub">600 Mbps fibre</div>
  </div>
</div>

<div class="am-item">
  <div class="am-icon"><i class="fa-solid fa-kitchen-set"></i></div>
  <div>
    <div class="am-name">Full kitchen</div>
    <div class="am-sub">Induction + microwave</div>
  </div>
</div>

<div class="am-item">
  <div class="am-icon"><i class="fa-solid fa-couch"></i></div>
  <div>
    <div class="am-name">Fully furnished</div>
    <div class="am-sub">Sofa, bed, desk, storage</div>
  </div>
</div>

<div class="am-item">
  <div class="am-icon"><i class="fa-solid fa-temperature-arrow-up"></i></div>
  <div>
    <div class="am-name">Underfloor heating</div>
    <div class="am-sub">Bathroom &amp; hallway</div>
  </div>
</div>

<div class="am-item">
  <div class="am-icon"><i class="fa-solid fa-tv"></i></div>
  <div>
    <div class="am-name">Smart TV</div>
    <div class="am-sub">55", Netflix ready</div>
  </div>
</div>

<div class="am-item">
  <div class="am-icon"><i class="fa-solid fa-lock"></i></div>
  <div>
    <div class="am-name">Smart lock</div>
    <div class="am-sub">Keyless entry, app access</div>
  </div>
</div>

<div class="am-item">
  <div class="am-icon"><i class="fa-solid fa-shower"></i></div>
  <div>
    <div class="am-name">Shower &amp; bathtub</div>
    <div class="am-sub">Separate unit</div>
  </div>
</div>

<div class="am-item">
  <div class="am-icon"><i class="fa-solid fa-elevator"></i></div>
  <div>
    <div class="am-name">Elevator</div>
    <div class="am-sub">7-floor building</div>
  </div>
</div>

<div class="am-item na">
  <div class="am-icon"><i class="fa-solid fa-square-parking"></i></div>
  <div>
    <div class="am-name">Parking</div>
    <div class="am-sub">Not included</div>
  </div>
</div>

<div class="am-item na">
  <div class="am-icon"><i class="fa-solid fa-bicycle"></i></div>
  <div>
    <div class="am-name">Bike storage</div>
    <div class="am-sub">Not available</div>
  </div>
</div>

      </div>
    </div><!-- /left -->

    <!-- RIGHT SIDEBAR -->
    <div class="right">

      <!-- MAP CARD -->
      <div class="map-card">
        <div class="map-preview" onclick="openMap()">
          <!-- Placeholder map SVG — replace with Google Maps / Mapbox embed -->
          <svg viewBox="0 0 280 160" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
            <rect width="280" height="160" fill="#E2DDD6"></rect>
            <rect x="0" y="68" width="280" height="6" fill="#F0EBE1"></rect>
            <rect x="0" y="103" width="220" height="5" fill="#F0EBE1"></rect>
            <rect x="78" y="0" width="5" height="160" fill="#F0EBE1"></rect>
            <rect x="158" y="0" width="4" height="160" fill="#F0EBE1"></rect>
            <rect x="0" y="0" width="76" height="66" rx="3" fill="#D5D0C6" opacity=".8"></rect>
            <rect x="85" y="0" width="71" height="66" rx="3" fill="#D5D0C6" opacity=".8"></rect>
            <rect x="0" y="75" width="76" height="50" rx="3" fill="#D5D0C6" opacity=".8"></rect>
            <rect x="85" y="75" width="53" height="50" rx="3" fill="#D5D0C6" opacity=".8"></rect>
            <rect x="163" y="0" width="117" height="66" rx="3" fill="#D5D0C6" opacity=".8"></rect>
            <rect x="163" y="75" width="117" height="80" rx="3" fill="#D5D0C6" opacity=".8"></rect>
            <ellipse cx="108" cy="40" rx="14" ry="11" fill="#3D6B4F" opacity=".28"></ellipse>
            <circle cx="140" cy="71" r="3.5" fill="white" stroke="#C8553D" stroke-width="1.5"></circle>
          </svg>
          <div class="map-pin">
            <div class="map-pin-dot"></div>
            <div class="map-pin-tail"></div>
          </div>
          <button class="map-expand-btn" onclick="event.stopPropagation(); openMap()">
            <i class="fa-solid fa-expand"></i> Expand
          </button>
        </div>

        <div class="map-card-body">
          <% @property.stations.each do |station| %>
            <div class="map-station">
              <i class="fa-solid fa-train-subway"></i>
              <%= station %>
            </div>
          <% end %>
          <a href="neighborhood.html?area=shinjuku" class="nb-link">
            <i class="fa-regular fa-map"></i>
            Explore <%= @property.neighborhood.name %>
            <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>


      </div>

      <!-- PRICE CARD -->
      <div class="price-card">
        <div class="price-main"><%= "¥#{@property.price}" %> <span>/ month</span></div>
        <div class="price-note">
          Price not exact<br>
        </div>

        <div class="stay-dates" data-controller="date-picker">
          <div class="date-field">
            <label class="date-label" for="start_date">Check-in</label>
            <input class="date-input" type="date" id="start_date"
                  data-date-picker-target="startDate"
                  data-action="change->date-picker#onChange">
          </div>
          <div class="date-field">
            <label class="date-label" for="end_date">Check-out</label>
            <input class="date-input" type="date" id="end_date"
                  data-date-picker-target="endDate"
                  data-action="change->date-picker#onChange">
          </div>
        </div>

        <%
          agent_email = "#properties@#{@property.vendor}.com"
          subject = ERB::Util.url_encode("Inquiry regarding Estralgo Meguro - Studio 302 / エストラルゴ目黒 - スタジオ302に関するお問い合わせ")
          body = ERB::Util.url_encode("Hello,\r\n\r\nI am interested in staying at #{@property.name} from June 15th to August 2nd and would like to request more information.\r\n\r\nThank you,\r\n\r\n---\r\n\r\nはじめまして。\r\n\r\nエストラルゴ目黒 - スタジオ302に、6月15日から8月2日までの滞在を検討しており、詳細についてお伺いしたく、ご連絡いたしました。\r\n\r\nご確認のほど、よろしくお願いいたします。")
        %>

        <a href="mailto:<%= agent_email %>?subject=<%= subject %>&body=<%= body %>" class="book-btn">
          Request to book
        </a>
      </div>

    </div><!-- /right -->
  </div><!-- /content-grid -->
</div>
