<% if @favorite_properties.empty? %>
  <%# ── EMPTY STATE (unchanged) ── %>
  <div class="fav-page">
    <div class="fav-header">
      <div>
        <p class="fav-eyebrow">
          <i class="fa-regular fa-heart"></i>
          Your saved stays
        </p>
        <h1 class="fav-title">Favorites</h1>
        <p class="fav-sub">0 saved homes in Tokyo</p>
      </div>
    </div>
    <div class="fav-empty">
      <div class="fav-empty-icon">
        <i class="fa-regular fa-heart"></i>
      </div>
      <h2 class="fav-empty-title">No saved homes yet</h2>
      <p class="fav-empty-body">
        Browse the map and tap the <i class="fa-regular fa-heart"></i> on any listing to save it here.
      </p>
      <%= link_to "Explore listings", root_path(anchor: "map"), class: "nb-btn nb-btn--primary" %>
    </div>
  </div>
<% else %>
  <%# ── COMPARISON WORKSPACE: cards (left) · priorities panel (right, shared with the map) ──
      The favorites controller live-scores the cards from the same engine + priorities:changed
      event the map uses; the panel's price/availability filters also drive it (wired additively
      in _priorities_panel.html.erb). %>
  <section class="fav-workspace"
           data-controller="favorites"
           data-favorites-properties-value="<%= @favorites_payload %>"
           data-favorites-anchor-value="<%= @anchor.present? ? json_escape(@anchor.to_json) : '{}' %>"
           data-favorites-normalized-inputs-value="<%= json_escape(@normalized_inputs.to_json) %>"
           data-favorites-checkin-value="<%= @checkin %>"
           data-action="priorities:changed@window->favorites#rescore">
    <div class="fav-main">
      <div class="fav-header">
        <div>
          <p class="fav-eyebrow">
            <i class="fa-regular fa-heart"></i>
            Your saved stays
          </p>
          <h1 class="fav-title">Favorites</h1>
          <p class="fav-sub" data-favorites-target="count">
            <%= @favorite_properties.count %> saved home<%= @favorite_properties.count == 1 ? "" : "s" %> in Tokyo
          </p>
        </div>
      </div>
      <div class="compare-grid" data-favorites-target="grid">
        <% @favorite_properties.each do |property| %>
          <%= render "properties/compare_card", property: property %>
        <% end %>
      </div>
    </div>
    <div class="fav-rail-dock">
      <%= render "pages/priorities_panel" %>
    </div>
  </section>
<% end %>
