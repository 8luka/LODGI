<!-- ── NEIGHBOURHOODS ── -->
<section id="neighbourhoods">
  <div class="section-eyebrow">Tokyo's best areas</div>
  <h2 class="section-title">Find your <em>neighbourhood</em></h2>
  <p class="section-sub">From quiet backstreets in Shimokitazawa to the pulse of Shinjuku — every home is fully furnished and ready from day one.</p>

  <div class="grid">

    <a class="card" href="#" onclick="event.preventDefault(); openDrawer('shinjuku')">
      <div class="card-img">
        <div class="card-img-bg" style="background:linear-gradient(140deg,#2C1810 0%,#8B4513 50%,#C9973A 100%);"></div>
        <div class="card-fav" onclick="event.stopPropagation(); toggleFav(this)">
          <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
        </div>
        <div class="card-tag">Most popular</div>
      </div>
      <div class="card-body">
        <div class="card-name">Shinjuku</div>
        <div class="card-desc">Everything within reach — trains, nightlife, parks, and Tokyo's best ramen at 3am.</div>
        <div class="card-meta">
          <div class="card-stats">
            <span class="card-stat">
              <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M3 9h18M9 21V9"></path></svg>
              48 listings
            </span>
          </div>
          <div class="card-price">from ¥72,000 <span>/ mo</span></div>
        </div>
      </div>
    </a>

    <a class="card" href="#" onclick="event.preventDefault(); openDrawer('shibuya')">
      <div class="card-img">
        <div class="card-img-bg" style="background:linear-gradient(140deg,#1a1a2e 0%,#C8553D 60%,#FF9B71 100%);"></div>
        <div class="card-fav" onclick="event.stopPropagation(); toggleFav(this)">
          <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
        </div>
        <div class="card-tag">Trendy</div>
      </div>
      <div class="card-body">
        <div class="card-name">Shibuya</div>
        <div class="card-desc">Fashion, café culture, and the world's most famous crossing right outside your door.</div>
        <div class="card-meta">
          <div class="card-stats">
            <span class="card-stat">
              <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M3 9h18M9 21V9"></path></svg>
              31 listings
            </span>
          </div>
          <div class="card-price">from ¥85,000 <span>/ mo</span></div>
        </div>
      </div>
    </a>

    <a class="card" href="#" onclick="event.preventDefault(); openDrawer('shimokita')">
      <div class="card-img">
        <div class="card-img-bg" style="background:linear-gradient(140deg,#0D2B1D 0%,#3D6B4F 55%,#7BBF99 100%);"></div>
        <div class="card-fav" onclick="event.stopPropagation(); toggleFav(this)">
          <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
        </div>
        <div class="card-tag">Local favourite</div>
      </div>
      <div class="card-body">
        <div class="card-name">Shimokitazawa</div>
        <div class="card-desc">Vintage shops, live music, and an artists' community unlike anywhere else in the city.</div>
        <div class="card-meta">
          <div class="card-stats">
            <span class="card-stat">
              <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M3 9h18M9 21V9"></path></svg>
              22 listings
            </span>
          </div>
          <div class="card-price">from ¥58,000 <span>/ mo</span></div>
        </div>
      </div>
    </a>

    <a class="card" href="#" onclick="event.preventDefault(); openDrawer('asakusa')">
      <div class="card-img">
        <div class="card-img-bg" style="background:linear-gradient(140deg,#1C0A2E 0%,#6B4FA0 55%,#B89FD8 100%);"></div>
        <div class="card-fav" onclick="event.stopPropagation(); toggleFav(this)">
          <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
        </div>
        <div class="card-tag">Historic</div>
      </div>
      <div class="card-body">
        <div class="card-name">Asakusa</div>
        <div class="card-desc">Temples, rickshaws, and the old soul of Tokyo — a living time capsule of old Edo.</div>
        <div class="card-meta">
          <div class="card-stats">
            <span class="card-stat">
              <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M3 9h18M9 21V9"></path></svg>
              19 listings
            </span>
          </div>
          <div class="card-price">from ¥64,000 <span>/ mo</span></div>
        </div>
      </div>
    </a>

    <a class="card" href="#" onclick="event.preventDefault(); openDrawer('roppongi')">
      <div class="card-img">
        <div class="card-img-bg" style="background:linear-gradient(140deg,#0A0A0A 0%,#2A2A2A 55%,#777 100%);"></div>
        <div class="card-fav" onclick="event.stopPropagation(); toggleFav(this)">
          <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
        </div>
        <div class="card-tag">Upscale</div>
      </div>
      <div class="card-body">
        <div class="card-name">Roppongi</div>
        <div class="card-desc">International crowd, world-class museums, and dining that never sleeps.</div>
        <div class="card-meta">
          <div class="card-stats">
            <span class="card-stat">
              <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M3 9h18M9 21V9"></path></svg>
              27 listings
            </span>
          </div>
          <div class="card-price">from ¥98,000 <span>/ mo</span></div>
        </div>
      </div>
    </a>

    <a class="card" href="#" onclick="event.preventDefault(); openDrawer('akihabara')">
      <div class="card-img">
        <div class="card-img-bg" style="background:linear-gradient(140deg,#002244 0%,#0057A8 55%,#63A4E0 100%);"></div>
        <div class="card-fav" onclick="event.stopPropagation(); toggleFav(this)">
          <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
        </div>
        <div class="card-tag">Tech hub</div>
      </div>
      <div class="card-body">
        <div class="card-name">Akihabara</div>
        <div class="card-desc">Electronics, anime culture, and excellent transit — central Tokyo at a lower price.</div>
        <div class="card-meta">
          <div class="card-stats">
            <span class="card-stat">
              <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M3 9h18M9 21V9"></path></svg>
              15 listings
            </span>
          </div>
          <div class="card-price">from ¥66,000 <span>/ mo</span></div>
        </div>
      </div>
    </a>

  </div>
</section>


<section class="about" id="about">
  <div class="about__grid">

    <div class="about__copy">
      <div class="about__eyebrow">Why Lodgi</div>
      <h2 class="about__title">Tokyo, <em>from day one</em></h2>
      <p class="about__body">
        Fully furnished homes across Tokyo's most liveable neighbourhoods —
        for foreigners who want to arrive and just live. No guarantors.
        No key money. English support, always.
      </p>
      <%= link_to "Browse homes", properties_path, class: "about__cta" %>
    </div>

    <div class="about__stats">
      <div class="about__stat">
        <div class="about__stat-number">158</div>
        <div class="about__stat-label">Furnished homes</div>
      </div>
      <div class="about__stat">
        <div class="about__stat-number">12</div>
        <div class="about__stat-label">Neighbourhoods</div>
      </div>
      <div class="about__stat">
        <div class="about__stat-number">4.9</div>
        <div class="about__stat-label">Average rating</div>
      </div>
      <div class="about__stat">
        <div class="about__stat-number">0</div>
        <div class="about__stat-label">Key money required</div>
      </div>
    </div>

  </div>
</section>


