<section class="hero" id="hero">
  <div class="search-bar-wrapper">
    <div class="search-bar">
      <div class="search-icon">
        <svg viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </div>

      <input type="text" placeholder="Search Tokyo neighbourhood, station...">

      <div class="search-pills">
        <div class="search-pill">Dates</div>
        <div class="search-pill">Guests</div>
      </div>

      <button class="search-btn" aria-label="Search">
        <svg viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>
    </div>
  </div>

  <div class="google-map-wrapper">
    <div id="map"></div>
  </div>
</section>

<div data-controller="maps" id="map" data-maps-properties-value="<%= @properties %>"></div>

<div class="scroll-cta">
    <a href="#neighbourhoods" class="scroll-btn">
      Explore neighbourhoods
      <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"></polyline></svg>
    </a>
</div>