<%# Home map hard-filter chips. These act on the map directly, so they live inside the
    `maps` controller element (every input is a data-maps-target). Distinct from the navbar
    trip search, which sets the trip; these refine the visible listings. %>
<div class="chip-row">
  <label class="chip chip--range">
    <iconify-icon icon="tabler:currency-yen"></iconify-icon>
    <span>Max <span data-maps-target="priceValue">¥<%= number_with_delimiter(@max_price) %></span></span>
    <input type="range" min="0" max="<%= @max_price %>" step="10000" value="<%= @max_price %>"
           data-maps-target="priceFilter" data-action="input->maps#applyFilters">
  </label>
  <label class="chip chip--select">
    <iconify-icon icon="tabler:layout-2"></iconify-icon>
    <select data-maps-target="layoutFilter" data-action="change->maps#applyFilters"></select>
  </label>
  <label class="chip chip--check">
    <input type="checkbox" data-maps-target="availabilityFilter" data-action="change->maps#applyFilters">
    <iconify-icon icon="tabler:calendar-check"></iconify-icon>
    <span>Only show available<%= @checkin.present? ? " for your dates" : "" %></span>
  </label>
  <label class="chip chip--check">
    <input type="checkbox" data-maps-target="transitToggle" data-action="change->maps#toggleTransit">
    <iconify-icon icon="tabler:train"></iconify-icon>
    <span>Transit Map</span>
  </label>
</div>
