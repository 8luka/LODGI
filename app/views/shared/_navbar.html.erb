<nav class="navbar navbar-expand-sm navbar-light navbar-lewagon">
  <div class="container-fluid">
    <%= link_to root_path, class: "navbar-brand d-flex align-items-center gap-2" do %>
      <%= image_tag "/icon.png", width: 100 %>
    <% end %>
    <%= render "shared/search" %>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav ms-auto align-items-center nav-links">
        <li class="nav-item">
          <%= link_to map_path, class: "nav-link" do %>
            <svg viewBox="0 0 24 24"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon><line x1="8" y1="2" x2="8" y2="18"></line><line x1="16" y1="6" x2="16" y2="22"></line></svg>
            Map
          <% end %>
        </li>
        <li class="nav-item">
          <%= link_to "#neighborhoods", class: "nav-link" do %>
            <svg viewBox="0 0 24 24"><path d="M1,21 L1,16 L3,16 L3,12 L6,12 L6,14 L8,14 L8,9 L10,9 L10,13 L11,13 L11,6 L12,4 L13,6 L13,13 L14,13 L14,10 L17,10 L17,13 L19,13 L19,15 L21,15 L21,17 L23,17 L23,21 Z"/></svg>
            Explore neighborhoods
          <% end %>
        </li>
        <li class="nav-item">
          <%= link_to favorites_path, class: "nav-link" do %>
            <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
            Favorites
          <% end %>
        </li>
        <% if user_signed_in? %>
          <li class="nav-item dropdown nav-avatar">
            <a href="#" class="avatar" id="navbarDropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
              <%= image_tag "https://www.shutterstock.com/image-vector/vector-flat-illustration-grayscale-avatar-600nw-2281862025.jpg", class: "avatar", alt: "dropdown menu" %>
            </a>
            <div class="dropdown-menu dropdown-menu-end avatar-dropdown" aria-labelledby="navbarDropdown">
              <%= link_to "#", class: "dropdown-item" do %>
                <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                My account
              <% end %>
              <div class="dropdown-divider"></div>
              <span class="dropdown-item-text text-muted small px-3 py-1">Currency</span>
              <%= link_to "¥ JPY", set_currency_path(currency: "JPY"), class: "dropdown-item #{"active" if (session[:currency] || "JPY") == "JPY"}", data: { turbo_method: :post } %>
              <%= link_to "€ EUR", set_currency_path(currency: "EUR"), class: "dropdown-item #{"active" if (session[:currency] || "JPY") == "EUR"}", data: { turbo_method: :post } %>
              <%= link_to "$ USD", set_currency_path(currency: "USD"), class: "dropdown-item #{"active" if (session[:currency] || "JPY") == "USD"}", data: { turbo_method: :post } %>
              <div class="dropdown-divider"></div>
              <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "dropdown-item signout" do %>
                <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                Sign out
              <% end %>
            </div>
          </li>
        <% else %>
          <li class="nav-item ms-2">
            <%= link_to "Login", new_user_session_path, class: "nav-link" %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>
