      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav ms-auto align-items-center nav-links">
        <li class="nav-item">
          <%= link_to "#about", class: "nav-link" do %>
