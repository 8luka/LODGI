<%# Global navbar trip search. Submits POST to inquiries_path; controller saves/updates
    the inquiry and redirects to map_path. State is loaded from session inquiry. %>
<% hero ||= false %>
<% current_trip_type = @trip_type || "visiting" %>
<% current_anchor = @selected_anchor %>
<%
  _checkin_d  = @checkin.present?  ? (Date.parse(@checkin)  rescue nil) : nil
  _checkout_d = @checkout.present? ? (Date.parse(@checkout) rescue nil) : nil
  _date_str   = if _checkin_d && _checkout_d
                  "#{_checkin_d.strftime('%-d %b')} – #{_checkout_d.strftime('%-d %b')}"
                end
%>
<div class="trip-search <%= 'trip-search--hero' if hero %>"
     data-controller="trip-setup"
     data-trip-setup-anchors-value="<%= trip_anchors.to_json %>"
     data-trip-setup-trip-type-value="<%= current_trip_type %>"
     data-trip-setup-current-tab-value="<%= current_trip_type == "education" ? "campus" : (current_trip_type == "business" ? "work" : "neighborhood") %>"
     data-trip-setup-selected-id-value="<%= current_anchor&.dig('id') %>"
     data-trip-setup-selected-name-value="<%= current_anchor&.dig('name') %>">
  <button type="button" class="trip-search__bar" data-trip-setup-target="toggle" data-action="trip-setup#toggle">
    <iconify-icon icon="tabler:search"></iconify-icon>
    <span class="trip-search__summary" data-trip-setup-target="summary">
      <% if current_anchor || @checkin.present? %>
        <%
          _trip_icon = case current_trip_type
                       when "business"  then "tabler:briefcase"
                       when "education" then "tabler:book"
                       else                  "tabler:map-pin"
                       end
        %>
        <span class="summary-right">
          <% if current_anchor %>
            <span class="summary-part">
              <iconify-icon icon="<%= _trip_icon %>" class="summary-icon"></iconify-icon>
              <%= current_anchor['name'] %>
            </span>
          <% end %>
          <% if _date_str %>
            <span class="summary-divider"></span>
            <span class="summary-part">
              <iconify-icon icon="tabler:calendar" class="summary-icon"></iconify-icon>
              <%= _date_str %>
            </span>
          <% end %>
          <% if @guests.present? && @guests.to_i > 0 %>
            <span class="summary-divider"></span>
            <span class="summary-part">
              <iconify-icon icon="tabler:user" class="summary-icon"></iconify-icon>
              <%= @guests %>
            </span>
          <% end %>
        </span>
      <% end %>
    </span>
  </button>
  <div class="trip-search__dropdown" data-trip-setup-target="panel" hidden>
    <%= form_with url: inquiries_path, method: :post, data: { turbo: false } do %>
      <div class="trip-form__body">
        <div class="trip-form__header">
          <h2 class="trip-form__title">What brings you to Tokyo?</h2>
          <p class="trip-form__sub">Tell us about your trip and we'll point you in the right direction.</p>
        </div>
        <%# Logistics %>
        <div class="trip-form__logistics">
          <div class="field">
            <label class="field__label">Check in</label>
            <input type="date" name="checkin" value="<%= @checkin %>" class="field__input"
                 data-trip-setup-target="checkin" data-action="change->trip-setup#validate">
          </div>
          <div class="field">
            <label class="field__label">Check out</label>
            <input type="date" name="checkout" value="<%= @checkout %>" class="field__input"
                 data-trip-setup-target="checkout" data-action="change->trip-setup#validate">
          </div>
          <div class="field">
            <label class="field__label">Guests</label>
            <select name="guests" class="field__input">
              <% [1, 2, 3, 4].each do |n| %>
                <option value="<%= n %>" <%= "selected" if @guests.to_i == n %>><%= n == 4 ? "4+ guests" : "#{n} guest#{'s' if n > 1}" %></option>
                <% end %>
              </select>
            </div>
          </div>
          <%# Trip type tiles %>
          <div class="trip-tiles">
            <% [["visiting", "tabler:map-pin", "Visiting", "tourism / leisure"],
            ["business", "tabler:briefcase", "Business", "work / meetings"],
            ["education", "tabler:book", "Education", "uni / course"]].each do |key, icon, name, sub| %>
              <button type="button" class="trip-tile" data-trip-type="<%= key %>"
                  data-trip-setup-target="tripTypeTile" data-action="trip-setup#selectTripType">
                <iconify-icon icon="<%= icon %>"></iconify-icon>
                <span class="trip-tile__name"><%= name %></span>
                <span class="trip-tile__sub"><%= sub %></span>
              </button>
            <% end %>
          </div>
          <input type="hidden" name="trip_type" value="<%= current_trip_type %>" data-trip-setup-target="tripTypeField">
          <%# Anchor section %>
          <div class="anchor-section">
            <div class="anchor-section__header">
              <span class="anchor-section__prompt" data-trip-setup-target="anchorPrompt">Where's your work?</span>
              <button type="button" class="anchor-section__skip" data-action="trip-setup#skip">Skip — no preference</button>
            </div>
            <p class="anchor-section__help" data-trip-setup-target="anchorHelp">
              Pick the place you'll need to get to most often. We'll score every listing by commute time.
            </p>
            <div class="anchor-search">
              <iconify-icon icon="tabler:search"></iconify-icon>
              <input type="text" placeholder="Search — e.g. Waseda, Shibuya, Tokyo Tower"
                 data-trip-setup-target="anchorSearch" data-action="input->trip-setup#filter">
            </div>
            <div class="anchor-tabs">
              <% [["neighborhood", "Neighborhoods"], ["landmark", "Landmarks"], ["work", "Work areas"], ["campus", "Campuses"]].each do |cat, label| %>
                <button type="button" class="anchor-tab" data-category="<%= cat %>"
                    data-trip-setup-target="anchorTab" data-action="trip-setup#selectTab"><%= label %></button>
              <% end %>
              <%= link_to map_path(pin: 1), class: "anchor-tab anchor-tab--pin" do %>
                <iconify-icon icon="mdi:map-marker-plus"></iconify-icon>
                Drop a pin
              <% end %>
            </div>
            <div class="anchor-grid" data-trip-setup-target="anchorGrid"></div>
            <div class="anchor-empty" data-trip-setup-target="emptyState" hidden>No match.</div>
            <input type="hidden" name="anchor" value="<%= current_anchor&.dig('id') %>" data-trip-setup-target="anchorIdField">
          </div>
        </div>
        <%# /trip-form__body %>
        <%# Footer — outside the scroll area so it's always visible %>
        <div class="trip-form__footer">
          <span class="trip-form__selected">Selected: <strong data-trip-setup-target="selectedLabel">none</strong></span>
          <div class="trip-form__actions">
            <% if @checkin.present? || @selected_anchor.present? %>
              <a href="<%= clear_inquiry_path %>" class="btn btn--ghost">
                Clear search
              </a>
            <% end %>
            <button type="submit" class="btn btn--primary" data-trip-setup-target="submitBtn">
              <iconify-icon icon="tabler:search"></iconify-icon> Search stays
            </button>
          </div>
        </div>
      <% end %>
    </div>
  </div>
