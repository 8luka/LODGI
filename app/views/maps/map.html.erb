<h1>Tokyo Map</h1>

<div id="map"></div>
<script>
  function initMap() {
    const tokyo = {
      lat: 35.6764,
      lng: 139.6500
    };

    const map = new google.maps.Map(
      document.getElementById("map"),
      {
        zoom: 12,
        center: tokyo
      }
    );
  }

  window.initMap = initMap;
</script>
